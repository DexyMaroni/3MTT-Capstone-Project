# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/
env/

# Django
*.log
local_settings.py

# The development database. It holds demo accounts and order history that
# "manage.py migrate && manage.py seed_demo" recreates from scratch, so there
# is nothing here worth versioning -- and password hashes should not be in a
# public repository even for throwaway accounts.
db.sqlite3
db.sqlite3-journal

# Output of "collectstatic". Generated from static/, never edited by hand.
staticfiles/

# Runtime uploads. Anything a farmer uploads through the site lands here, and
# it is rebuildable for the demo data, so it stays out of git.
#
# Note this is NOT where the demo photos live: those are committed under
# listings/seed_images/ so the project works offline. "manage.py load_images"
# copies them from there into media/ at setup time.
media/

# Secrets. Environment variables are read in settings.py; keep the actual
# values out of the repository.
.env
.env.*

# Editors and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
